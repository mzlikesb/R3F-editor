{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "outpost",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws", "/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "BASE_ROOM", "class_name": "BaseRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BaseRoom"] }],
  // Each PR preview gets its own DO namespace and storage; the env binding must be repeated here.
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "BASE_ROOM", "class_name": "BaseRoom" }],
    },
  },
  "observability": { "enabled": true },
}
